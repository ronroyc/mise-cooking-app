# Copy this file to `.env` and fill in real values.
# `.env` is listed in .gitignore, so your secrets never end up on GitHub.

# Where the SQLite database lives. Leave unset to use data/sliced.db.
# DATABASE_URL=sqlite:///data/sliced.db

# Turns on AI ingredient recognition on the Inventory page (and the substitution
# assistant in Milestone 6). Slice'd works without it; the AI features just stay off.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
